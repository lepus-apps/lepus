import {
  "lepus-apps/lepus/lib" @lepus,
  "moonbitlang/async",
  "lepus-apps/lepus/plugins/lepus_plugin_cli",
  "lepus-apps/lepus/plugins/lepus_plugin_support",
}

supported_targets = "+native"

pkgtype(kind: "executable")

options(
  link: { "native": { "cc": "_build/native/release/build/cli/cc/cc.exe" } },
  targets: { "main.mbt": [ "native" ] },
)
